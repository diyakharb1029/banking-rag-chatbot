# ============================================================
# GenAI Banking RAG Chatbot — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# ============================================================

# --- Google Gemini API ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- ChromaDB ---
# "local" uses the embedded on-disk DB (recommended for Render free tier)
CHROMA_MODE=local
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K_RESULTS=5

# --- CORS (set to your Vercel domain in production) ---
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# --- Upload ---
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./data/uploads

# --- Server ---
PORT=8000
LOG_LEVEL=INFO
