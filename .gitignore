# ============================================================
# .gitignore — GenAI Banking RAG Chatbot
# ============================================================

# --- Secrets (NEVER commit these) ---
.env
.env.local
.env.production
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
venv/
env/
.venv/
pip-log.txt
pip-delete-this-directory.txt
*.pyc

# --- ChromaDB data (large binary files) ---
backend/data/chroma_db/
backend/data/uploads/

# --- Node / Next.js ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# --- Model cache ---
backend/.cache/
*.onnx
